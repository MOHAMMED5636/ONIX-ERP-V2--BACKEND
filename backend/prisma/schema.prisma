// Atomic per-year counter for client reference numbers: O-CL-YYYY/NNNN
model ClientReferenceSequence {
  year       Int @id
  lastNumber Int @default(0)

  @@map("client_reference_sequences")
}

model Project {
  id               String        @id @default(uuid())
  projectNumber    Int           @unique @default(autoincrement())
  name             String
  referenceNumber  String        @unique
  pin              String?       @unique // Project Identification Number
  clientId         String?
  client           Client?       @relation(fields: [clientId], references: [id])
  owner            String?
  description      String?
  status           ProjectStatus @default(OPEN)
  projectManager   String?       @db.VarChar(100) // Free-text project manager name (not linked to users)
  startDate        DateTime?
  endDate          DateTime?
  deadline         DateTime?
  planDays         Int? // Planned duration in days
  remarks          String? // General remarks
  assigneeNotes    String? // Notes from assignee
  
  // Location & Project Details (from contracts)
  location         String? // Location string (can be coordinates or address)
  makaniNumber     String? // Makani number (UAE addressing system - 10 digits)
  plotNumber       String? // Plot number
  community        String? // Community name
  projectType      String? // Project type (e.g., "Residential", "Commercial", "Industrial")
  projectFloor     String? // Number of floors (stored as string for flexibility)
  developerProject String? // Developer name/project

  /// GPS center for site geofencing (smart attendance)
  siteLatitude     Float?
  siteLongitude    Float?
  geofenceRadiusM  Float?        @default(100)
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  // Relations
  createdBy         String?
  creator           User?               @relation(fields: [createdBy], references: [id])
  tenders           Tender[]
  documents         Document[]
  assignedEmployees ProjectAssignment[] @relation("ProjectAssignments")
  tasks             Task[]
  checklists        ProjectChecklist[]
  attachments       ProjectAttachment[]
  chats             ProjectChat[]
  chatParticipants  ProjectChatParticipant[]
  contracts         Contract[]
  questionnaireQuestions QuestionnaireQuestion[]
  questionnaireAssignments QuestionnaireAssignment[]
  activityLogs      ProjectActivityLog[]
  deletionOtpRequests ProjectDeletionOtpRequest[]
  assetRequests     AssetRequest[]
  projectManagerTransfers ProjectManagerTransfer[]
  taskFocusSelections     UserProjectTaskFocus[]
  projectAttendanceLogs   ProjectAttendanceLog[]
  pmAssignmentNotices     ProjectPmAssignmentNotice[]

  @@map("projects")
}

/// Internal ERP workflow for PM/Manager project deletion (no email).
/// Status: PENDING_APPROVAL | OTP_GENERATED | OTP_VERIFIED | DELETED | REJECTED | EXPIRED | LOCKED
model ProjectDeletionOtpRequest {
  id             String    @id @default(uuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectName    String    @db.VarChar(255)
  projectRef     String?   @db.VarChar(64)
  requestedById  String
  requestedBy    User      @relation("ProjectDeletionRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  approvedById   String?
  approvedBy     User?     @relation("ProjectDeletionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  rejectedById   String?
  rejectedBy     User?     @relation("ProjectDeletionRejecter", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedAt     DateTime?
  otpHash        String?   @db.VarChar(128)
  expiresAt      DateTime?
  failedAttempts Int       @default(0)
  status         String    @default("PENDING_APPROVAL") @db.VarChar(24)
  usedAt         DateTime?
  otpVerifiedAt  DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([projectId, requestedById, status])
  @@index([status, createdAt])
  @@map("project_deletion_otp_requests")
}

enum ProjectManagerTransferStatus {
  ACTIVE
  COMPLETED
}

/// Temporary reassignment of project ownership while a PM is on leave / unavailable.
model ProjectManagerTransfer {
  id                    String                       @id @default(uuid())
  projectId             String
  project               Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  oldProjectManagerId   String
  oldProjectManager     User                         @relation("PmTransferOld", fields: [oldProjectManagerId], references: [id], onDelete: Restrict)
  newProjectManagerId   String
  newProjectManager     User                         @relation("PmTransferNew", fields: [newProjectManagerId], references: [id], onDelete: Restrict)
  transferReason        String?                      @db.Text
  startDate             DateTime                     @db.Date
  endDate               DateTime?                    @db.Date
  transferredById       String
  transferredBy         User                         @relation("PmTransferBy", fields: [transferredById], references: [id], onDelete: Restrict)
  status                ProjectManagerTransferStatus @default(ACTIVE)
  previousManagerId     String?
  previousManagerEmail  String?
  previousProjectManagerText String?                 @db.VarChar(100)
  completedAt           DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@index([projectId, status])
  @@index([oldProjectManagerId, status])
  @@index([newProjectManagerId, status])
  @@index([status, endDate])
  @@map("project_manager_transfers")
}

/// Unseen project assignments for PMs (contract assignment, transfer, new project linked to their contract).
model ProjectPmAssignmentNotice {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source     String    @default("ASSIGNMENT") @db.VarChar(24) // ASSIGNMENT | TRANSFER
  notifiedAt DateTime  @default(now())
  seenAt     DateTime?

  @@unique([userId, projectId])
  @@index([userId, seenAt])
  @@map("project_pm_assignment_notices")
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  SUBMITTED_IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
  CLOSED
}

/// Audit-style feed for the project drawer (History / All): subtasks, assignments, comments, etc.
model ProjectActivityLog {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("ProjectActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(64)
  taskId    String?
  summary   String   @db.VarChar(600)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("project_activity_logs")
}

model Tender {
  id              String       @id @default(uuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id])
  name            String
  referenceNumber String       @unique
  clientId        String?
  client          Client?      @relation(fields: [clientId], references: [id])
  status          TenderStatus @default(OPEN)

  // Tender Details
  scopeOfWork              String?
  technicalDrawingsLink    String?
  hasInvitationFees        Boolean   @default(false)
  invitationFeeAmount      Decimal?  @db.Decimal(10, 2)
  tenderAcceptanceDeadline DateTime?
  bidSubmissionDeadline    DateTime?
  additionalNotes          String?

  // Attachment
  attachmentFile String? // File path or URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  invitations          TenderInvitation[]
  technicalSubmissions TechnicalSubmission[]

  @@map("tenders")
}

enum TenderStatus {
  OPEN
  CLOSED
  AWARDED
  REJECTED
  CANCELLED
}

model TenderInvitation {
  id              String           @id @default(uuid())
  tenderId        String
  tender          Tender           @relation(fields: [tenderId], references: [id])
  engineerId      String
  engineer        User             @relation("AssignedEngineer", fields: [engineerId], references: [id])
  invitationToken String           @unique
  status          InvitationStatus @default(PENDING)
  assignedAt      DateTime         @default(now())
  acceptedAt      DateTime?

  @@map("tender_invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model TechnicalSubmission {
  id          String           @id @default(uuid())
  tenderId    String
  tender      Tender           @relation(fields: [tenderId], references: [id])
  engineerId  String
  submittedAt DateTime         @default(now())
  status      SubmissionStatus @default(SUBMITTED)

  // Relations
  documents Document[]

  @@map("technical_submissions")
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model Document {
  id            String  @id @default(uuid())
  module        String // "PRJ", "HR", "CLI", "FIN", "GEN"
  entityCode    String // Reference number
  documentType  String // "CNTR", "DRW", "RPT", etc.
  year          Int
  sequence      String
  referenceCode String  @unique
  fileName      String
  filePath      String
  fileUrl       String?
  fileSize      Int
  mimeType      String

  // Relations
  projectId    String?
  project      Project?             @relation(fields: [projectId], references: [id])
  submissionId String?
  submission   TechnicalSubmission? @relation(fields: [submissionId], references: [id])

  uploadedBy String?
  uploadedAt DateTime @default(now())
  /// Optional expiry date for licenses, approvals, etc.
  expiresAt  DateTime?
  /// SHA-256 of file bytes (used to block duplicate uploads for the same module + entity)
  contentSha256 String?

  @@index([module, entityCode, contentSha256])
  @@map("documents")
}

// Project Assignment - Links employees to projects
model ProjectAssignment {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation("ProjectAssignments", fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   User     @relation("AssignedEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  assignedBy String? // Admin/HR who assigned
  role       String? // Role in project (e.g., "Engineer", "Manager", "Supervisor")

  @@unique([projectId, employeeId])
  @@map("project_assignments")
}

// Task Model
model Task {
  id             String       @id @default(uuid())
  title          String
  description    String?
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTaskId   String?      // For subtasks - references parent task
  parentTask     Task?        @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks       Task[]       @relation("TaskSubtasks") // Child tasks/subtasks
  status         TaskStatus   @default(PENDING)
  // Workflow / dependency status (separate from general status to avoid breaking existing logic)
  workflowStatus TaskWorkflowStatus @default(NOT_STARTED)
  priority       TaskPriority @default(MEDIUM)
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  estimatedHours Decimal?     @db.Decimal(10, 2)
  actualHours    Decimal?     @db.Decimal(10, 2)
  /// Full-focus vs monitoring — drives workload score coefficient
  effortType     TaskEffortType @default(FULL_FOCUS)
  /// Technical weight / complexity (1 = very light … 5 = heavy)
  taskWeight     Int            @default(3)
  /// PM/manager rating for completed tasks (0..5). 0 means "not rated".
  rating         Int            @default(0)
  tags           String[] // Array of tags
  // Additional fields for subtasks/child tasks
  category       String?      // Task category (Design, Development, etc.)
  referenceNumber String?      // Reference number for subtask
  planDays       Int?         // Plan days for subtask
  remarks        String?      @db.Text // Remarks
  assigneeNotes  String?      @db.Text // Assignee notes
  link           String?      @db.VarChar(2048) // External URL / document link
  assignedEmployeeId String?  // Assigned employee ID for subtasks/child tasks
  assignedEmployee User?      @relation("AssignedTaskEmployee", fields: [assignedEmployeeId], references: [id])
  location       String?      // Location
  makaniNumber   String?      // Makani number
  plotNumber     String?      // Plot number
  community      String?      // Community
  projectType    String?      // Project type
  projectFloor   String?      // Project floor
  developerProject String?     // Developer project
  predecessors   String?      @db.VarChar(500) // Task keys (e.g. "1.1" or "1.1,1.2") that must be completed before this task; used for locking
  // Normalized predecessor relation (used for strict sequencing)
  predecessorId  String?
  predecessor    Task?        @relation("TaskPredecessor", fields: [predecessorId], references: [id])
  dependents     Task[]       @relation("TaskPredecessor")
  // Simple execution order for project management (ascending per project/parent)
  taskOrder      Int?         @map("task_order")
  // Permanent display slot per (projectId, parentTaskId): set on create only; gaps allowed after deletes.
  stableWorkSeq  Int?         @map("stable_work_seq")
  // Insert-between display: e.g. anchor 2 + suffix "A" → user sees 4-2A (projectNumber 4). Internal stableWorkSeq stays hidden.
  displayAnchorSeq Int?       @map("display_anchor_seq")
  displaySuffix    String?    @db.VarChar(8) @map("display_suffix")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?
  deletedAt      DateTime?

  // Relations
  assignments   TaskAssignment[]
  checklists    TaskChecklist[]
  attachments   TaskAttachment[]
  comments      TaskComment[]
  delegations   TaskDelegation[]   // Audit trail of task delegations
  questionnaireQuestions QuestionnaireQuestion[]
  questionnaireAssignments QuestionnaireAssignment[]
  reminder      TaskReminder?
  focusSelections UserProjectTaskFocus[]

  @@map("tasks")
}

/// Per-user "current task" highlight within a project (persists across tabs/sessions).
model UserProjectTaskFocus {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  selectedTaskId String
  selectedTask   Task     @relation(fields: [selectedTaskId], references: [id], onDelete: Cascade)
  selectedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@map("user_project_task_focus")
}

model TaskReminder {
  id            String    @id @default(uuid())
  taskId        String    @unique
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  triggerType   String    @default("DUE_DATE") // DUE_DATE | SPECIFIC_DATE
  specificDate  DateTime?
  frequency     String    @default("DAILY") // ONCE | DAILY | WEEKLY
  hour          Int       @default(8)
  minute        Int       @default(0)
  notifyUserIds String[]
  description   String?   @db.Text
  lastSentAt    DateTime?
  isActive      Boolean   @default(true)
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  alerts        TaskReminderAlert[]

  @@map("task_reminders")
}

/// One critical-alarm instance fired to one user. Drives the on-top alarm popup
/// and tracks acknowledgement / snooze / completion / escalation state.
model TaskReminderAlert {
  id                String       @id @default(uuid())
  reminderId        String
  reminder          TaskReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  taskId            String
  userId            String
  status            String       @default("PENDING") // PENDING | SNOOZED | ACKNOWLEDGED | COMPLETED
  priority          String       @default("NORMAL")  // NORMAL | HIGH | CRITICAL
  dueAt             DateTime     @default(now())     // when the reminder became due
  firedAt           DateTime     @default(now())     // first alarm fire
  lastFiredAt       DateTime     @default(now())     // latest (re)fire — escalation timers anchor here
  snoozeCount       Int          @default(0)
  snoozedUntil      DateTime?
  acknowledgedById  String?
  acknowledgedAt    DateTime?
  completedAt       DateTime?
  escalatedAt       DateTime?    // 5-minute priority escalation timestamp
  managerNotifiedAt DateTime?    // 15-minute manager escalation timestamp
  ignoredLoggedAt   DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId, status])
  @@index([status, lastFiredAt])
  @@index([reminderId])
  @@map("task_reminder_alerts")
}

/// Immutable audit trail for every reminder/alarm action (system + user).
model TaskReminderActionLog {
  id         String   @id @default(uuid())
  alertId    String?
  reminderId String?
  taskId     String?
  actorId    String?  // null = system action
  action     String   // FIRED | REFIRED | ACKNOWLEDGED | SNOOZED | COMPLETED | PRIORITY_ESCALATED | MANAGER_NOTIFIED | IGNORED_LOGGED
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([alertId, createdAt])
  @@index([reminderId, createdAt])
  @@map("task_reminder_action_logs")
}

enum TaskWorkflowStatus {
  WAITING_FOR_PREDECESSOR
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED_IN_PROGRESS
  NOT_REQUIRED
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskEffortType {
  FULL_FOCUS
  MONITORING
}

// Task Assignment - Links employees to tasks
model TaskAssignment {
  id         String               @id @default(uuid())
  taskId     String
  task       Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId String
  employee   User                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt DateTime             @default(now())
  assignedBy String?
  status     TaskAssignmentStatus @default(PENDING)

  @@unique([taskId, employeeId])
  @@map("task_assignments")
}

enum TaskAssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DELEGATED  // Original assignee after delegating to someone else
}

// Task Delegation - Audit trail when employee delegates a child/subtask to another employee
model TaskDelegation {
  id                 String   @id @default(uuid())
  taskId             String
  task               Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  originalAssigneeId String
  originalAssignee   User     @relation("DelegationOriginal", fields: [originalAssigneeId], references: [id], onDelete: Cascade)
  newAssigneeId      String
  newAssignee        User     @relation("DelegationNew", fields: [newAssigneeId], references: [id], onDelete: Cascade)
  delegatedById      String   // User who performed delegation (typically original assignee)
  delegatedBy        User     @relation("DelegationBy", fields: [delegatedById], references: [id], onDelete: Cascade)
  delegatedAt        DateTime @default(now())
  reason             String?  @db.Text

  @@index([taskId])
  @@index([originalAssigneeId])
  @@index([newAssigneeId])
  @@index([delegatedAt])
  @@map("task_delegations")
}

// Questionnaire Template - Reusable checklist templates
model QuestionnaireTemplate {
  id          String    @id @default(uuid())
  name        String    // Template name (e.g., "Safety Checklist", "Quality Control")
  description String?
  isActive    Boolean   @default(true)
  isLocked    Boolean   @default(false) // Locked templates cannot be modified
  createdBy   String?   // User ID who created the template
  creator     User?     @relation("TemplateCreator", fields: [createdBy], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Questions in this template
  questions   QuestionnaireQuestion[]
  
  // Assignments - where this template is used
  assignments QuestionnaireAssignment[]

  @@map("questionnaire_templates")
}

// Questionnaire Question - Questions within a template
model QuestionnaireQuestion {
  id           String              @id @default(uuid())
  templateId   String?
  template     QuestionnaireTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  // Question details
  questionText String              // The actual question
  description  String?             // Optional description/instructions
  order        Int                 @default(0) // Display order
  isRequired   Boolean             @default(true) // Whether answer is required
  
  // Assignment details (if not part of a template)
  projectId    String?
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  subtaskId    String?             // For sub-tasks (if you have a subtask model)
  
  // Status
  isLocked     Boolean             @default(false) // Locked questions cannot be answered
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  createdBy    String?             // User ID who created the question
  
  // Responses to this question
  responses    QuestionnaireResponse[]

  @@map("questionnaire_questions")
}

// Questionnaire Response - Employee answers to questions
model QuestionnaireResponse {
  id          String              @id @default(uuid())
  questionId  String
  question    QuestionnaireQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  // Response details
  answer      QuestionnaireAnswer // Selected option
  remarks     String?             // Optional remarks/notes
  
  // Tracking
  answeredBy  String              // Employee user ID
  employee    User                @relation("QuestionnaireRespondent", fields: [answeredBy], references: [id])
  answeredAt  DateTime            @default(now()) // Date and time of response
  
  // Status
  isLocked    Boolean             @default(false) // Locked responses cannot be modified
  
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([questionId, answeredBy]) // One response per employee per question
  @@map("questionnaire_responses")
}

// Enum for questionnaire answers
enum QuestionnaireAnswer {
  ACTION_PLAN_APPLIED
  NOT_AVAILABLE
  NOT_APPLIED
  PENDING
}

// Questionnaire Assignment - Links templates to Projects/Tasks/Sub-Tasks
model QuestionnaireAssignment {
  id          String              @id @default(uuid())
  templateId  String
  template    QuestionnaireTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  // Assignment target
  projectId   String?
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  subtaskId  String?              // For sub-tasks
  
  // Status
  isActive    Boolean             @default(true)
  assignedBy  String?             // User ID who assigned this template
  assignedAt  DateTime            @default(now())
  
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("questionnaire_assignments")
}

// --- Feedback & surveys → Dynamic Form Builder (sections, submissions, logic, sharing) ---
model FeedbackSurvey {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  dueDate     DateTime?
  /// DRAFT | PUBLISHED | CLOSED (legacy ACTIVE treated as PUBLISHED in API)
  status      String   @default("DRAFT")
  department  String?
  ownerId     String?
  owner       User?    @relation("FeedbackSurveyOwner", fields: [ownerId], references: [id])
  createdBy   String?
  creator     User?    @relation("FeedbackSurveyCreator", fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections        FeedbackSurveySection[]
  questions       FeedbackSurveyQuestion[]
  assignments     FeedbackSurveyAssignment[]
  responses       FeedbackSurveyResponse[]
  submissions     FeedbackSurveySubmission[]
  settings        FeedbackSurveySettings?
  logicRules      FeedbackSurveyLogicRule[]
  shareLinks      FeedbackSurveyShareLink[]
  collaborators   FeedbackSurveyCollaborator[]
  actions         FeedbackSurveyAction[]

  @@map("feedback_surveys")
}

model FeedbackSurveySection {
  id          String   @id @default(uuid())
  surveyId    String
  survey      FeedbackSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions          FeedbackSurveyQuestion[]
  logicRulesAsTarget FeedbackSurveyLogicRule[] @relation("LogicTargetSection")

  @@index([surveyId])
  @@map("feedback_survey_sections")
}

model FeedbackSurveyQuestion {
  id           String   @id @default(uuid())
  surveyId     String
  survey       FeedbackSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  sectionId    String?
  section      FeedbackSurveySection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  questionText String
  description  String?
  order        Int      @default(0)
  /// SHORT_TEXT, LONG_TEXT, NUMBER, EMAIL, PHONE, SINGLE_CHOICE, MULTIPLE_CHOICE, DROPDOWN, DATE, TIME, FILE, RATING, LINEAR_SCALE, MATRIX; legacy TEXT maps to SHORT_TEXT
  questionType String   @default("SHORT_TEXT")
  options      String?  @db.Text
  placeholder  String?
  config       Json?
  validation   Json?
  isRequired   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  responses            FeedbackSurveyResponse[]
  answers              FeedbackSurveyAnswer[]
  logicRulesAsSource   FeedbackSurveyLogicRule[] @relation("LogicRuleSource")
  logicRulesTargetQuestion FeedbackSurveyLogicRule[] @relation("LogicRuleTargetQuestion")

  @@index([surveyId])
  @@index([sectionId])
  @@map("feedback_survey_questions")
}

model FeedbackSurveySettings {
  surveyId                 String    @id
  survey                   FeedbackSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  allowMultipleSubmissions Boolean   @default(false)
  requireLogin             Boolean   @default(true)
  closingDate              DateTime?
  notifyOnSubmit           Boolean   @default(false)
  confirmationMessage      String?   @db.Text
  allowEditAfterSubmit     Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@map("feedback_survey_settings")
}

model FeedbackSurveyLogicRule {
  id               String   @id @default(uuid())
  surveyId         String
  survey           FeedbackSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  sourceQuestionId String
  sourceQuestion   FeedbackSurveyQuestion @relation("LogicRuleSource", fields: [sourceQuestionId], references: [id], onDelete: Cascade)
  operator         String
  value            String   @db.Text
  action           String
  targetQuestionId String?
  targetQuestion   FeedbackSurveyQuestion? @relation("LogicRuleTargetQuestion", fields: [targetQuestionId], references: [id], onDelete: SetNull)
  targetSectionId  String?
  targetSection    FeedbackSurveySection? @relation("LogicTargetSection", fields: [targetSectionId], references: [id], onDelete: SetNull)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([surveyId])
  @@index([sourceQuestionId])
  @@map("feedback_survey_logic_rules")
}

model FeedbackSurveyAssignment {
  id          String         @id @default(uuid())
  surveyId    String
  survey      FeedbackSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt  DateTime       @default(now())
  completedAt DateTime?

  @@unique([surveyId, userId])
  @@index([userId])
  @@map("feedback_survey_assignments")
}

model FeedbackSurveyShareLink {
  id           String   @id @default(uuid())
  surveyId     String
  survey       FeedbackSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime?
  requireLogin Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdById  String?
  createdBy    User?    @relation("FeedbackShareLinkCreator", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  submissions FeedbackSurveySubmission[]

  @@index([surveyId])
  @@map("feedback_survey_share_links")
}

model FeedbackSurveySubmission {
  id            String   @id @default(uuid())
  surveyId      String
  survey        FeedbackSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  shareLinkId   String?
  shareLink     FeedbackSurveyShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  sessionToken  String?  @unique
  submittedAt   DateTime?
  isComplete    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  answers FeedbackSurveyAnswer[]

  @@index([surveyId])
  @@index([userId])
  @@map("feedback_survey_submissions")
}

model FeedbackSurveyAnswer {
  id           String   @id @default(uuid())
  submissionId String
  submission   FeedbackSurveySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     FeedbackSurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value        String   @db.Text
  filePath     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([submissionId, questionId])
  @@index([questionId])
  @@map("feedback_survey_answers")
}

model FeedbackSurveyCollaborator {
  id        String   @id @default(uuid())
  surveyId  String
  survey    FeedbackSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  createdAt DateTime @default(now())

  @@unique([surveyId, userId])
  @@index([userId])
  @@map("feedback_survey_collaborators")
}

model FeedbackSurveyAction {
  id         String   @id @default(uuid())
  surveyId   String
  survey     FeedbackSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  actionType String
  fieldMap   Json
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([surveyId])
  @@map("feedback_survey_actions")
}

model FeedbackSurveyResponse {
  id         String                 @id @default(uuid())
  surveyId   String
  survey     FeedbackSurvey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  questionId String
  question   FeedbackSurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  answer     String                 @db.Text
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([questionId, userId])
  @@index([surveyId])
  @@index([userId])
  @@map("feedback_survey_responses")
}

// Email audit trail (SMTP send events)
model EmailLog {
  id              String   @id @default(uuid())
  recipientEmail  String
  subject         String
  template        String
  status          String   // SENT | FAILED
  relatedEmployeeId String?
  errorMessage    String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([recipientEmail])
  @@index([relatedEmployeeId])
  @@map("email_logs")
}

// Email Management module
model EmailTemplate {
  id        String   @id @default(uuid())
  name      String
  fromEmail String?  // optional (defaults to EMAIL_FROM)
  cc        String?  @db.Text
  bcc       String?  @db.Text
  subject   String
  html      String   @db.Text
  variables String?  @db.Text // JSON string array for placeholder suggestions
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  triggers EmailTrigger[]
  queueItems EmailQueueItem[]

  @@unique([name])
  @@map("email_templates")
}

model EmailTrigger {
  id           String   @id @default(uuid())
  name         String
  eventKey     String   // e.g. EMPLOYEE_CREATED_ERP_ACCESS
  templateId   String
  template     EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  enabled      Boolean  @default(true)
  recipients   String?  @db.Text // JSON: { to, cc, bcc } mapping rules
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([eventKey])
  @@map("email_triggers")
}

model EmailQueueItem {
  id          String   @id @default(uuid())
  templateId  String?
  template    EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  toEmail     String
  cc          String?  @db.Text
  bcc         String?  @db.Text
  subject     String
  html        String   @db.Text
  status      String   @default("PENDING") // PENDING | SENDING | SENT | FAILED
  attempts    Int      @default(0)
  lastError   String?  @db.Text
  relatedEmployeeId String?
  scheduledAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([toEmail])
  @@map("email_queue")
}

// Workplace company policies (acknowledgements per user)
enum CompanyPolicyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  EXPIRED
}

enum PolicyAssignmentStatus {
  ASSIGNED
  NOT_VIEWED
  VIEWED
  DOWNLOADED
  ACKNOWLEDGED
  OVERDUE
  EXPIRED
}

model CompanyPolicy {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  department  String   @default("General")
  /// When set, only employees linked to this company/branch see the policy.
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  fileName    String?
  filePath    String?  // stored filename under uploads/policies
  fileType    String   @default("PDF")
  fileSize    String   @default("—")
  isActive    Boolean  @default(true)
  status      CompanyPolicyStatus @default(DRAFT)
  publishDate DateTime?
  expiryDate  DateTime?
  /// Days after assignment to acknowledge before marked overdue
  dueDays     Int?
  contentHtml String?  @db.Text
  assignRoles String[] @default([])
  assignUserIds String[] @default([])
  createdById String?
  createdBy   User?    @relation("CompanyPolicyCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  acknowledgements CompanyPolicyAcknowledgement[]
  assignments      CompanyPolicyAssignment[]
  auditLogs        CompanyPolicyAuditLog[]

  @@index([companyId])
  @@index([status])
  @@map("company_policies")
}

model CompanyPolicyAssignment {
  id             String                 @id @default(uuid())
  policyId       String
  policy         CompanyPolicy          @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt     DateTime               @default(now())
  status         PolicyAssignmentStatus @default(ASSIGNED)
  viewedAt       DateTime?
  downloadedAt   DateTime?
  acknowledgedAt DateTime?
  dueAt          DateTime?
  reminderCount  Int                    @default(0)
  lastReminderAt DateTime?

  @@unique([policyId, userId])
  @@index([policyId])
  @@index([userId])
  @@index([status])
  @@map("company_policy_assignments")
}

/// Append-only policy audit trail (no updates/deletes via application)
model CompanyPolicyAuditLog {
  id          String         @id @default(uuid())
  policyId    String?
  policy      CompanyPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?          @relation("CompanyPolicyAuditSubject", fields: [userId], references: [id], onDelete: SetNull)
  actorId     String?
  actor       User?          @relation("CompanyPolicyAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  actorName   String?
  employeeId  String?
  department  String?
  policyTitle String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([policyId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("company_policy_audit_logs")
}

model CompanyPolicyAcknowledgement {
  id               String        @id @default(uuid())
  policyId         String
  policy           CompanyPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt   DateTime      @default(now())

  @@unique([policyId, userId])
  @@index([userId])
  @@map("company_policy_acknowledgements")
}

// Project Checklist (Legacy - keeping for backward compatibility)
model ProjectChecklist {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  completedBy String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("project_checklists")
}

// Task Checklist (Legacy - keeping for backward compatibility)
model TaskChecklist {
  id          String    @id @default(uuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  completedBy String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("task_checklists")
}

// Project Attachment
model ProjectAttachment {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName   String
  filePath   String
  fileUrl    String?
  fileSize   Int
  mimeType   String
  uploadedBy String?
  uploadedAt DateTime @default(now())

  @@map("project_attachments")
}

// Task Attachment
model TaskAttachment {
  id         String   @id @default(uuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName   String
  filePath   String
  fileUrl    String?
  fileSize   Int
  mimeType   String
  uploadedBy String?
  uploadedAt DateTime @default(now())

  @@map("task_attachments")
}

// Task Comment
model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  content   String
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("task_comments")
}

// Company Model - For managing multiple companies/entities
model Company {
  id       String        @id @default(uuid())
  name     String
  tag      String? // Company tag/abbreviation (e.g., "ONIX", "TECH")
  address  String?
  industry String?
  founded  String? // Year founded
  status   CompanyStatus @default(ACTIVE)

  // Branch relationship (optional)
  parentCompanyId String?
  parentCompany   Company? @relation("CompanyBranches", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  branches        Company[] @relation("CompanyBranches")

  // Contact Information
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  contactExtension String?

  // License Information
  licenseCategory String? // License category (e.g., Commercial, Industrial, Professional)
  legalType       String? // Legal structure (e.g., LLC, Corporation, Partnership)
  licenseExpiry   DateTime?
  licenseStatus   LicenseStatus @default(ACTIVE)
  dunsNumber      String? // D&B D-U-N-S Number
  registerNo      String? // Registration Number
  issueDate       DateTime? // License issue date
  mainLicenseNo   String? // Main License Number
  dcciNo          String? // DCCI Dubai Chamber number
  trnNumber       String? // TRN (Tax Registration Number) / ESBN

  // ========== Personal & Representative Info ==========
  fullNameEn             String?
  fullNameAr             String?
  delegatedCardNumber    String?
  businessPartnerNumber  String?
  emiratesId             String?
  emiratesIdExpiry       DateTime?
  passportNumber         String?
  nationality            String?
  dateOfBirth            DateTime?
  gender                 String?
  mobileNumber           String?
  phoneNumber            String?
  email                  String?
  representativeTitleEn  String?
  representativeTitleAr  String?

  // ========== Company Info (extended) ==========
  nameAr           String?
  businessName     String?
  branchName       String?
  companyCategory  String?
  companyType      String?
  clientRole        String?
  websiteUrl        String?

  // ========== Licensing & Regulatory ==========
  establishmentCode       String?
  establishmentFileNumber  String?
  licenseAuthority        String?
  licenseNumber           String?
  licenseType             String?
  licenseIssueDate        DateTime?
  unifiedDedFileNumber     String?
  dedLicenseNumber        String?
  prequalificationSubmitted Boolean?
  prequalificationExpiry   DateTime?
  commercialRegisterNumber String?
  commercialRegisterDate   DateTime?
  membershipNumber         String?
  membershipIssueDate      DateTime?
  membershipExpiry         DateTime?
  membershipLegalStatus    String?
  trakheesId               String?
  practiceRegisterNumber   String?
  practiceRegisterIssueDate DateTime?
  practiceRegisterExpiry   DateTime?
  municipalityClassification String?
  establishmentMolNumber   String?
  molCardIssueDate         DateTime?
  molCardExpiry            DateTime?
  sponsorName              String?
  establishmentLocation    String?  @db.Text
  subscriptionStartDate    DateTime?
  subscriptionEndDate      DateTime?

  // ========== Tax Info ==========
  vatRegistrationNumber           String?
  vatEffectiveRegistrationDate    DateTime?
  vatReturnPeriod                 String?
  vatReturnDueDate                String?
  vatTaxPeriodCycle               String?
  vatCertificateIssueDate        DateTime?
  corporateTaxRegistrationNumber  String?
  corporateTaxEffectiveRegistrationDate DateTime?
  firstCorporateTaxPeriodStart     DateTime?
  firstCorporateTaxPeriodEnd       DateTime?
  firstCorporateTaxFilingDeadline  DateTime?

  // ========== Contact & Address ==========
  officePhone      String?
  telephone2       String?
  faxNumber        String?
  companyEmail     String?
  contactPersonName String?
  contactMobile    String?
  poBox            String?
  city             String?
  region           String?
  street           String?
  addressDetails   String?  @db.Text
  makaniNumber     String?
  parcelId         String?
  buildingNumber   String?
  floorNumber      String?
  subscriptionExpiryDate DateTime?

  // ========== Ownership ==========
  ownerName    String?
  partnersInfo Json?   // [{ partnerName, partnerId, partnerNationality, partnerRole, sharePercentage }]

  // ========== Activities ==========
  activitiesInfo Json?  // [{ activityCode, activityName, activityDescription, activityStatus }]

  // ========== Notes & Telecom ==========
  licenseRemarks String?  @db.Text
  connectionType String?

  // Branding
  logo       String? // Logo file path or URL
  header     String? // Header file path or URL
  footer     String? // Footer file path or URL
  letterhead String? // Official letterhead for HR documents & certificates
  payslipTemplate String? // Blank payslip layout image (PNG/JPG) for PDF generation
  stamp      String? // Official company seal/stamp image (PNG/JPG) for payslips & HR documents

  // Customization / Preferences (Organization-level; applied app-wide)
  // All numeric values are stored in base units (sqm, meter, m³, AED). Conversion at display/calculation only.
  defaultCurrency String?  @default("AED")  // Display currency: AED, USD, EUR, INR, SAR (extensible)
  lengthUnit      String?  @default("meter") // meter | feet
  areaUnit        String?  @default("sqm")   // sqm | sqft
  volumeUnit      String?  @default("m3")    // m3 | ft3
  heightUnit      String?  @default("meter") // meter | feet
  weightUnit      String?  @default("kg")    // kg | ton (optional)

  // Office Location (for attendance system)
  officeLatitude  Float? // Office latitude coordinate
  officeLongitude Float? // Office longitude coordinate
  attendanceRadius Float? @default(200) // Allowed radius in meters (default 200m)
  requireOfficeGeofence Boolean @default(true) // Office employees must be within radius to check in/out
  requireFacialAttendance Boolean @default(false) // Require mobile selfie + face match
  facialMatchMinScore     Float   @default(0.55) // Minimum match score 0–1

  // Statistics
  employees Int @default(0)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?

  // Relations
  departments        Department[]
  attendances        Attendance[]
  attendancePrograms AttendanceProgram[]
  companyAttachments CompanyAttachment[]
  companyPolicies    CompanyPolicy[]
  userAccessGrants   UserCompanyAccess[]
  clients            Client[]

  @@map("companies")
}

/// Admin/HR users may be assigned one or more companies they can view and manage.
model UserCompanyAccess {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("UserCompanyAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  grantedById String?
  grantedBy   User?    @relation("UserCompanyAccessGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("user_company_access")
}

/// Legal / compliance files per company (multiple files per category).
model CompanyAttachment {
  id           String                    @id @default(uuid())
  companyId    String
  company      Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category     CompanyAttachmentCategory
  fileName     String
  filePath     String // e.g. /uploads/company-attachments/...
  fileSize     Int
  mimeType     String
  label        String?
  /// Optional expiry for licenses, certificates, etc.
  expiresAt    DateTime?
  uploadedById String?
  uploadedBy   User?                     @relation("CompanyAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([companyId])
  @@index([companyId, category])
  @@map("company_attachments")
}

enum CompanyAttachmentCategory {
  TRADE_LICENSE
  EJARI
  MEMORANDUM_OF_ASSOCIATION
  ESTABLISHMENT_CARD
  BANK_DETAILS
  TAX_REGISTRATION
  INSURANCE
  COMPANY_IDENTITY
  ISO_CERTIFICATE
  OTHER_CERTIFICATION
}

/// Per-company attendance program templates (weekly Mon–Sun schedule). User.attendanceProgram stores the program name.
model AttendanceProgram {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  description     String?  @db.Text
  weeklySchedule  Json
  hoursSummary    String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("attendance_programs")
}

// Organization-wide preferences (Admin Profile). Singleton: one row. Decoupled from Company.
// All numeric values stored in base units (sqm, meter, m³, AED). Conversion at display/calculation only.
model OrganizationPreferences {
  id              String   @id @default(uuid())
  defaultCurrency String   @default("AED")  // AED, USD, EUR, INR, SAR
  lengthUnit      String   @default("meter") // meter | feet
  areaUnit        String   @default("sqm")   // sqm | sqft
  volumeUnit      String   @default("m3")    // m3 | ft3
  heightUnit      String   @default("meter") // meter | feet
  weightUnit      String   @default("kg")    // kg | ton
  /// Workload algorithm: monitoring tasks counted at weight × this coefficient (default 0.3)
  workloadMonitoringCoefficient Decimal? @db.Decimal(4, 2)
  /// Subtask workload multiplier (default 0.5)
  workloadSubtaskCoefficient    Decimal? @db.Decimal(4, 2)
  /// Default planned days when task has no planDays (default 5)
  workloadDefaultPlannedDays    Int?
  /// Workload score at 100% employee capacity (default 10)
  workloadEmployeeCapacity      Decimal? @db.Decimal(6, 2)
  /// Utilization % above this = overloaded (red, default 100)
  workloadOverloadUtilizationPercent Decimal? @db.Decimal(6, 2)
  /// Minimum utilization % for "balanced" (green, default 50)
  workloadBalancedUtilizationMin     Decimal? @db.Decimal(6, 2)
  /// Maximum utilization % for "available" (blue, default 30)
  workloadAvailableUtilizationMax    Decimal? @db.Decimal(6, 2)
  /// Score above this = overloaded (red) — legacy fallback
  workloadOverloadThreshold     Decimal? @db.Decimal(6, 2)
  /// Minimum score for "balanced" (green) band lower bound — legacy fallback
  workloadBalancedMin           Decimal? @db.Decimal(6, 2)
  /// Maximum score for "available" (blue) band upper bound — legacy fallback
  workloadAvailableMax          Decimal? @db.Decimal(6, 2)
  updatedAt       DateTime @updatedAt
  updatedBy       String?  // Admin who last updated

  @@map("organization_preferences")
}

// Note: SubDepartment and Position models are defined after DepartmentStatus enum

enum CompanyStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  PENDING
  SUSPENDED
}

// Department Model - Belongs to a Company
model Department {
  id          String           @id @default(uuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      DepartmentStatus @default(ACTIVE)
  managerId   String? // User ID of department manager
  manager     User?            @relation("DepartmentManager", fields: [managerId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  subDepartments SubDepartment[]

  @@map("departments")
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

// SubDepartment Model - Belongs to a Department
model SubDepartment {
  id           String              @id @default(uuid())
  departmentId String
  department   Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  status       SubDepartmentStatus @default(ACTIVE)
  managerId    String? // User ID of sub-department manager
  manager      User?               @relation("SubDepartmentManager", fields: [managerId], references: [id])
  location     String?
  budget       String? // Budget as string (e.g., "$500,000")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  // Relations
  positions Position[]

  @@map("sub_departments")
}

enum SubDepartmentStatus {
  ACTIVE
  INACTIVE
}

// Position Model - Belongs to a SubDepartment
model Position {
  id              String         @id @default(uuid())
  subDepartmentId String
  subDepartment   SubDepartment  @relation(fields: [subDepartmentId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  status          PositionStatus @default(ACTIVE)
  managerId       String? // User ID of position manager
  manager         User?          @relation("PositionManager", fields: [managerId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  employeeAssignments EmployeePositionAssignment[]

  @@map("positions")
}

/// Additional visibility on org positions without changing the user’s primary directory fields.
model EmployeePositionAssignment {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation("EmployeePositionAssignmentSubject", fields: [userId], references: [id], onDelete: Cascade)
  positionId   String
  position     Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  assignedById String?
  assignedBy   User?    @relation("PositionAssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
