enum PositionStatus {
  ACTIVE
  INACTIVE
}

enum TeamChatRoomType {
  GENERAL
  DM
}

// Project Chat Model - Represents a chat conversation for a project
model ProjectChat {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String? // Optional chat title (defaults to project name)
  isActive  Boolean  @default(true) // Whether the chat is active
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  messages ProjectMessage[]

  @@map("project_chats")
}

/// Explicit project chat members (added from chat UI). Grants access even when not on project/task assignee lists.
model ProjectChatParticipant {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ProjectChatParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  addedById String?
  addedBy   User?    @relation("ProjectChatParticipantAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_chat_participants")
}

// Project Message Model - Represents individual messages in a project chat
model ProjectMessage {
  id          String      @id @default(uuid())
  chatId      String
  chat        ProjectChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId    String? // User ID who sent the message
  sender      User?       @relation("MessageSender", fields: [senderId], references: [id])
  content     String      @db.Text // Message content
  replyToMessageId String?
  replyTo     ProjectMessage?  @relation("ProjectMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies     ProjectMessage[] @relation("ProjectMessageReplies")
  deletedAt   DateTime? // Set when deleted for everyone
  deletedById String?
  deletedBy   User?       @relation("MessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  hides ProjectMessageHide[]
  reads ProjectMessageRead[]

  @@index([chatId, createdAt])
  @@index([replyToMessageId])
  @@map("project_messages")
}

/// WhatsApp-style read receipts: one row per (message, user) when the user has seen it.
model ProjectMessageRead {
  id        String         @id @default(uuid())
  messageId String
  message   ProjectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation("ProjectMessageReads", fields: [userId], references: [id], onDelete: Cascade)
  seenAt    DateTime       @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@map("project_message_reads")
}

/// Per-user hide (delete for me only)
model ProjectMessageHide {
  id        String         @id @default(uuid())
  messageId String
  message   ProjectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@map("project_message_hides")
}

/// Embedded ERP chat (general + DMs). Rooms are keyed by `roomKey` (e.g. "general", "dm:<a>:<b>").
model TeamChatRoom {
  id        String           @id @default(uuid())
  roomKey   String           @unique
  type      TeamChatRoomType @default(DM)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  participants TeamChatParticipant[]
  messages     TeamChatMessage[]

  @@map("team_chat_rooms")
}

model TeamChatParticipant {
  id        String       @id @default(uuid())
  roomId    String
  room      TeamChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([roomId, userId])
  @@index([userId])
  @@map("team_chat_participants")
}

model TeamChatMessage {
  id          String       @id @default(uuid())
  roomId      String
  room        TeamChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId    String?
  sender      User?        @relation("TeamChatSender", fields: [senderId], references: [id], onDelete: SetNull)
  content     String       @db.Text
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?        @relation("TeamChatMessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  hides TeamChatMessageHide[]

  @@index([roomId, createdAt])
  @@map("team_chat_messages")
}

/// Per-user hide (delete for me only) on team chat
model TeamChatMessageHide {
  id        String          @id @default(uuid())
  messageId String
  message   TeamChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@map("team_chat_message_hides")
}

// Contract Model - Represents contracts for projects
model Contract {
  id              String   @id @default(uuid())
  referenceNumber String   @unique
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Contract Details
  title            String
  description      String?        @db.Text
  contractType     String? // e.g., "Service", "Construction", "Consulting", "Maintenance"
  contractCategory String? // Contract category from dropdown
  status           ContractStatus @default(DRAFT)

  // Project Nature - Multi-select (stored as JSON array)
  projectNature String? @db.Text // JSON array: ["Interior Project", "Exterior Project", etc.]

  // Contract phases selected at creation (stored as JSON array of phase names)
  contractPhases String? @db.Text // JSON array: ["Concept Design", "Detailed Design", ...]

  // Company
  companyId   String? // Reference to Company model if exists
  companyName String? // Company name if not linked

  // Multiple Clients (stored as JSON array of client IDs)
  selectedClients String? @db.Text // JSON array of client IDs

  // Dates
  startDate  DateTime?
  endDate    DateTime?
  signedDate DateTime? // Date when contract was signed
  expiryDate DateTime? // Contract expiry date

  // Location Details
  makaniNumber   String? // Makani number (UAE addressing system - 10 digits)
  latitude       Decimal? @db.Decimal(10, 7) // Location latitude
  longitude      Decimal? @db.Decimal(10, 7) // Location longitude
  region         String? // Region/Area
  plotNumber     String? // Plot number
  community      String? // Community name
  numberOfFloors    Int? // Number of floors
  numberOfBasements Int? // Number of basements

  // Building Details
  buildingCost     Decimal? @db.Decimal(15, 2) // Building cost
  builtUpArea      Decimal? @db.Decimal(15, 2) // Built up area in sq ft
  buildingHeight   Decimal? @db.Decimal(10, 2) // Building height in meters
  structuralSystem String? // Structural system type
  buildingType     String? // Building type

  // Authority & Community
  authorityApprovalStatus   String? // Approval status: "Pending", "Approved", "Rejected", "Under Review"
  developerName             String? // Developer name
  authorityApprovalRequired Boolean @default(false) // Whether authority approval is required

  // Project Manager
  projectManager            String? @db.VarChar(100) // Free-text project manager name (not linked to users)

  // Financial Details
  contractValue Decimal? @db.Decimal(15, 2) // Total contract value
  currency      String?  @default("AED") // Currency code
  paymentTerms  String?  @db.Text // Payment terms and conditions

  // Contract Fees (stored as JSON array)
  contractFees String? @db.Text // JSON array of fee objects: [{name, type, amount, calculatedAmount, period, dueDate}]

  // Payment Schedule
  paymentScheduleType String? // "Standard" or "Custom"
  totalAmount         Decimal? @db.Decimal(15, 2) // Total amount
  installments        Int? // Number of installments
  perInstallment      Decimal? @db.Decimal(15, 2) // Amount per installment
  generateInvoice     Boolean  @default(false) // Whether to generate invoice

  // Parties
  contractorName    String? // Contractor/Service provider name
  contractorContact String? @db.Text // Contractor contact information
  clientName        String? // Client name (if not linked to Client model)
  clientContact     String? @db.Text // Client contact information

  // Legal & Terms
  termsAndConditions String? @db.Text // Terms and conditions
  specialClauses     String? @db.Text // Special clauses or notes
  renewalTerms       String? @db.Text // Renewal terms

  // Documents
  contractDocument String? // File path/URL for contract document
  attachments      String? @db.Text // JSON array of attachment paths

  // Manager Assignment
  assignedManagerId    String? // Manager user ID (references User)
  assignedManagerEmail String? // Manager email (for filtering - matches User.email)
  assignedManager       User?   @relation("AssignedContractManager", fields: [assignedManagerId], references: [id], onDelete: SetNull)

  // Metadata
  createdBy  String?
  creator    User?     @relation("ContractCreator", fields: [createdBy], references: [id])
  approvedBy String?
  approver   User?     @relation("ContractApprover", fields: [approvedBy], references: [id])
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contracts")
}

enum ContractStatus {
  DRAFT
  PENDING_REVIEW
  PENDING_SIGNATURE
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
  COMPLETED
}

enum AttendanceCategory {
  OFFICE
  SITE
  LABOR
}

/// Field / project attendance shift log (supervisor punches labor; PM self-punch at site).
model ProjectAttendanceLog {
  id           String    @id @default(uuid())
  employeeId   String
  employee     User      @relation("ProjectAttendanceEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Set when a supervisor punches in/out on behalf of a labor worker
  supervisorId String?
  supervisor   User?     @relation("ProjectAttendanceSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)

  punchIn      DateTime  @default(now())
  punchOut     DateTime?
  /// Labor cost in AED — calculated on punch-out for LABOR category only
  costAmount   Decimal   @default(0) @db.Decimal(12, 2)
  workedHours  Float?

  latitude           Float?
  longitude          Float?
  distanceFromSiteM  Float?
  isWithinGeofence   Boolean?
  punchOutLatitude   Float?
  punchOutLongitude  Float?

  facePhotoPath   String?
  faceMatchScore  Float?
  faceVerified    Boolean @default(false)
  autoClosed      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([projectId])
  @@index([supervisorId])
  @@index([punchIn])
  @@index([employeeId, punchOut])
  @@map("project_attendance_logs")
}

// Attendance model for location-based check-in/check-out
model Attendance {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserAttendances", fields: [userId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Attendance type
  type AttendanceType @default(CHECK_IN) // CHECK_IN or CHECK_OUT

  // Location data (optional - location-based attendance can be disabled)
  employeeLatitude  Float? // Employee's latitude when marking attendance (optional)
  employeeLongitude Float? // Employee's longitude when marking attendance (optional)
  distanceFromOffice Float? // Calculated distance from office in meters (optional)
  isWithinRadius    Boolean? // Whether employee was within allowed radius (optional)

  // Timestamps
  checkInTime  DateTime? // Check-in timestamp
  checkOutTime DateTime? // Check-out timestamp
  date         DateTime  @default(now()) @db.Date // Date of attendance (date only, no time)

  // Metadata for audit
  ipAddress    String? // IP address of the request
  userAgent    String? @db.Text // User agent/browser info
  deviceInfo   String? @db.Text // Device information (mobile, desktop, etc.)
  locationAccuracy Float? // GPS accuracy in meters

  // Facial verification (mobile attendance)
  facePhotoPath  String?
  faceMatchScore Float?
  faceVerified   Boolean @default(false)

  // Status
  status AttendanceStatus @default(PRESENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, type]) // One check-in and one check-out per day per user
  @@index([userId])
  @@index([date])
  @@index([companyId])
  @@map("attendances")
}

enum EngineeringDailyReportStatus {
  DRAFT
  SUBMITTED
}

/// Mandatory engineering daily report before check-out (one per employee per day).
model EngineeringDailyReport {
  id          String                       @id @default(uuid())
  userId      String
  user        User                         @relation("UserEngineeringDailyReports", fields: [userId], references: [id], onDelete: Cascade)
  reportDate  DateTime                     @db.Date
  status      EngineeringDailyReportStatus @default(DRAFT)
  roleSection String?
  payload     Json
  submittedAt DateTime?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  checkoutSessions CheckoutSession[]

  @@unique([userId, reportDate])
  @@index([userId])
  @@index([reportDate])
  @@map("engineering_daily_reports")
}

/// Paused checkout while employee completes daily report.
model CheckoutSession {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation("UserCheckoutSessions", fields: [userId], references: [id], onDelete: Cascade)
  reportDate           DateTime  @db.Date
  token                String    @unique
  reportId             String?
  report               EngineeringDailyReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  dailyReportSubmitted Boolean   @default(false)
  completedAt          DateTime?
  expiresAt            DateTime
  latitude             Float?
  longitude            Float?
  accuracy             Float?
  createdAt            DateTime  @default(now())

  @@index([userId, reportDate])
  @@map("checkout_sessions")
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  ON_LEAVE
  LATE
  EARLY_DEPARTURE
  VACATION
  PUBLIC_HOLIDAY
  OUT_OF_LOCATION
}

model Leave {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation("LeaveRequester", fields: [userId], references: [id])
  type        LeaveType
  status      LeaveStatus @default(PENDING)
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  days        Int
  reason      String      @db.Text
  attachments String?     @db.Text // JSON array of file paths/URLs

  // Line-manager workflow: ANNUAL/UNPAID with assigned manager go PENDING → manager APPROVED → HR final; others skip manager
  managerApprovalStatus  LeaveManagerApprovalStatus @default(NOT_REQUIRED)
  managerActionById      String?
  managerActionBy        User?                      @relation("LeaveManagerAction", fields: [managerActionById], references: [id])
  managerActionAt        DateTime?                  @db.Timestamptz
  managerRejectionReason String?                    @db.Text

  // Special leave: relation for bereavement (spouse | first_degree), context for others
  relationOrContext    String?   @db.Text
  // Reporting: when employee reported absence (sick/emergency within 24h)
  reportedAbsenceAt    DateTime? @db.Timestamptz
  // When documentation/medical report received (sick: within 3 working days)
  documentationReceivedAt DateTime? @db.Timestamptz
  // Management reschedule: effective dates when leave was rescheduled (max 3 months from original)
  rescheduledStartDate  DateTime? @db.Date
  rescheduledEndDate    DateTime? @db.Date
  rescheduledAt         DateTime? @db.Timestamptz

  approvedById   String?
  approvedBy     User?     @relation("LeaveApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedById   String?
  rejectedBy     User?     @relation("LeaveRejector", fields: [rejectedById], references: [id])
  rejectedAt     DateTime?
  rejectionReason String?  @db.Text

  // Enterprise annual leave workflow (multi-step approvals)
  workflowStage           LeaveWorkflowStage?
  assignedLineManagerId   String?
  assignedLineManager     User?     @relation("LeaveAssignedLineManager", fields: [assignedLineManagerId], references: [id])
  assignedSecondLineManagerId String?
  assignedSecondLineManager   User? @relation("LeaveAssignedSecondLineManager", fields: [assignedSecondLineManagerId], references: [id])
  secondManagerApprovalStatus LeaveManagerApprovalStatus @default(NOT_REQUIRED)
  secondManagerActionById     String?
  secondManagerActionBy       User?   @relation("LeaveSecondManagerAction", fields: [secondManagerActionById], references: [id])
  secondManagerActionAt       DateTime? @db.Timestamptz
  secondManagerRejectionReason String?  @db.Text
  projectConflict         Boolean?
  projectConfirmationNotes String?  @db.Text
  projectConfirmedById    String?
  projectConfirmedBy      User?     @relation("LeaveProjectConfirmedBy", fields: [projectConfirmedById], references: [id])
  projectConfirmedAt      DateTime? @db.Timestamptz
  financeClearanceStatus  String?   // PENDING | CLEARED | ISSUE_FOUND
  financeRemarks          String?   @db.Text
  financeActionById       String?
  financeActionBy         User?     @relation("LeaveFinanceActionBy", fields: [financeActionById], references: [id])
  financeActionAt         DateTime? @db.Timestamptz
  hrFinalApprovedAt       DateTime? @db.Timestamptz
  certificateFilename     String?
  certificateGeneratedAt  DateTime? @db.Timestamptz
  returnToWorkDate        DateTime? @db.Date
  onHoldReason            String?   @db.Text

  workflowLogs LeaveWorkflowLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([startDate])
  @@index([managerApprovalStatus])
  @@index([workflowStage])
  @@map("leaves")
}

model LeaveWorkflowLog {
  id            String              @id @default(uuid())
  leaveId       String
  leave         Leave               @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?               @relation("LeaveWorkflowLogActor", fields: [actorId], references: [id])
  action        String
  previousStage LeaveWorkflowStage?
  newStage      LeaveWorkflowStage?
  comment       String?             @db.Text
  createdAt     DateTime            @default(now())

  @@index([leaveId])
  @@map("leave_workflow_logs")
}

model LeavePolicy {
