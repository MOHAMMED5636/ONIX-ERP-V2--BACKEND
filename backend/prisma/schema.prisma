  gmActionById              String?
  gmActionBy                User?                   @relation("ResignationGmAction", fields: [gmActionById], references: [id])
  gmActionAt                DateTime?
  gmComments                String?                 @db.Text
  retentionOffer            Json?
  retentionOfferAccepted    Boolean?
  retentionResponseAt       DateTime?

  hrReviewById              String?
  hrReviewBy                User?                   @relation("ResignationHrReview", fields: [hrReviewById], references: [id])
  hrReviewAt                DateTime?
  hrReviewComments          String?                 @db.Text

  financeClearanceStatus    String?                 // APPROVED | REJECTED | ON_HOLD
  financeRemarks            String?                 @db.Text
  financeChecklist          Json?
  financeActionById         String?
  financeActionBy           User?                   @relation("ResignationFinanceAction", fields: [financeActionById], references: [id])
  financeActionAt           DateTime?

  assetChecklist            Json?
  exitChecklist             Json?
  hrFinalById               String?
  hrFinalBy                 User?                   @relation("ResignationHrFinal", fields: [hrFinalById], references: [id])
  hrFinalAt                 DateTime?
  hrFinalComments           String?                 @db.Text

  finalExitDate             DateTime?               @db.Date
  relievingLetterPath       String?
  experienceCertificatePath String?
  settlementRequestRef      String?

  workflowLogs              ResignationWorkflowLog[]

  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@index([userId])
  @@index([status])
  @@index([workflowStage])
  @@index([assignedProjectManagerId])
  @@map("resignation_requests")
}

model ResignationWorkflowLog {
  id            String                    @id @default(uuid())
  resignationId String
  resignation   ResignationRequest        @relation(fields: [resignationId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?                     @relation("ResignationWorkflowLogActor", fields: [actorId], references: [id])
  action        String
  previousStage ResignationWorkflowStage?
  newStage      ResignationWorkflowStage?
  comment       String?                   @db.Text
  metadata      Json?
  createdAt     DateTime                  @default(now())

  @@index([resignationId])
  @@map("resignation_workflow_logs")
}

/// Web Push (browser notifications) — one row per browser/device subscription.
model BrowserPushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("browser_push_subscriptions")
}

/// Tracks document-expiry reminder notifications already sent (dedupe by threshold).
model DocumentExpiryNotificationLog {
  id              String   @id @default(uuid())
  recipientUserId String
  recipient       User     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  sourceKey       String
  thresholdDays   Int
  sentAt          DateTime @default(now())

  @@unique([recipientUserId, sourceKey, thresholdDays])
  @@index([recipientUserId])
  @@index([sourceKey])
  @@map("document_expiry_notification_logs")
}

// ============================================================
// Enterprise Asset Management (EAM)
// ============================================================

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_REPAIR
  DISPOSED
}

enum AssetLocationType {
  WAREHOUSE
  OFFICE_ROOM
  REMOTE
  IT_REPAIR_LAB
}

enum MaintenanceIssueType {
  HARDWARE_FAILURE
  SOFTWARE_ISSUE
  ROUTINE_MAINTENANCE
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MaintenanceTicketStatus {
  OPEN
  ASSIGNED_TO_TECH
  IN_REPAIR
  RESOLVED
  CLOSED
}

enum AssetLogAction {
  PROVISIONED
  ASSIGNED
  TRANSFERRED
  RETURNED_TO_STOCK
  SENT_TO_REPAIR
  REPAIR_COMPLETED
  SCRAPPED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  PENDING_SERIALS
  COMPLETE
}

enum PurchaseRequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  FULFILLED
}

model AssetCategory {
  id                       String   @id @default(uuid())
  name                     String   @unique
  minThreshold             Int      @default(0)
  depreciationLifespanYears Decimal @db.Decimal(5, 2)
  salvageValuePercentage   Decimal  @default(10) @db.Decimal(5, 2)
  assets                   Asset[]
  purchaseOrderLines       PurchaseOrderLine[]
  purchaseRequisitions     PurchaseRequisition[]
  assetRequests            AssetRequest[]
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("asset_categories")
}

model AssetTagSequence {
  year       Int @id
  lastNumber Int @default(0)

  @@map("asset_tag_sequences")
}

model Asset {
  id            String            @id @default(uuid())
  assetTag      String            @unique
  qrToken       String            @unique @default(uuid())
  categoryId    String
  category      AssetCategory     @relation(fields: [categoryId], references: [id])
  serialNumber  String?           @unique
  purchaseCost  Decimal           @db.Decimal(12, 2)
  purchaseDate  DateTime          @db.Date
  status        AssetStatus       @default(AVAILABLE)
  assignedToId  String?
  assignedTo    User?             @relation("AssetCustodian", fields: [assignedToId], references: [id], onDelete: SetNull)
  locationType  AssetLocationType @default(WAREHOUSE)
  locationId    String?
  isQrPrinted   Boolean           @default(false)
  disposedAt    DateTime?
  grnId         String?
  grn           GoodsReceiptNote? @relation(fields: [grnId], references: [id], onDelete: SetNull)
  logs          AssetLog[]
  tickets       MaintenanceTicket[]
  requestAssignments AssetRequestAssignment[]
  returns       AssetReturn[]
  damageCases   AssetDamageCase[]
  lossCases     AssetLossCase[]
  clearanceRecords AssetClearanceRecord[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([assignedToId])
  @@index([isQrPrinted])
  @@index([qrToken])
  @@map("assets")
}

model AssetLog {
  id              String         @id @default(uuid())
  assetId         String
  asset           Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  action          AssetLogAction
  performedById   String?
  performedBy     User?          @relation("AssetLogPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  oldCustodianId  String?
  newCustodianId  String?
  notes           String?        @db.Text
  metadata        Json?
  createdAt       DateTime       @default(now())

  @@index([assetId, createdAt])
  @@map("asset_logs")
}

model MaintenanceTicket {
  id            String                  @id @default(uuid())
  assetId       String
  asset         Asset                   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reporterId    String
  reporter      User                    @relation("MaintenanceReporter", fields: [reporterId], references: [id])
  technicianId  String?
  technician    User?                   @relation("MaintenanceTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  issueType     MaintenanceIssueType
  priority      MaintenancePriority     @default(MEDIUM)
  status        MaintenanceTicketStatus @default(OPEN)
  repairCost    Decimal?                @db.Decimal(12, 2)
  notes         String?                 @db.Text
  resolution    String?                 @db.Text
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  closedAt      DateTime?

  @@index([assetId])
  @@index([reporterId])
  @@index([technicianId])
  @@index([status])
  @@map("maintenance_tickets")
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  poNumber    String              @unique
  status      PurchaseOrderStatus @default(DRAFT)
  vendorName  String?
  notes       String?             @db.Text
  createdById String?
  createdBy   User?               @relation("PoCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines       PurchaseOrderLine[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String         @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  categoryId       String
  category         AssetCategory  @relation(fields: [categoryId], references: [id])
  description      String?
  quantity         Int
  unitCost         Decimal        @db.Decimal(12, 2)
  receivedQuantity Int            @default(0)
  grns             GoodsReceiptNote[]

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

model GoodsReceiptNote {
  id                  String             @id @default(uuid())
  grnNumber           String             @unique
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine  @relation(fields: [purchaseOrderLineId], references: [id])
  quantityReceived    Int
  receivedById        String?
  receivedBy          User?              @relation("GrnReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  receivedAt          DateTime           @default(now())
  status              GoodsReceiptStatus @default(PENDING_SERIALS)
  assets              Asset[]
  createdAt           DateTime           @default(now())

  @@index([purchaseOrderLineId])
  @@map("goods_receipt_notes")
}

model PurchaseRequisition {
  id                 String                    @id @default(uuid())
  categoryId         String
  category           AssetCategory             @relation(fields: [categoryId], references: [id])
  suggestedQuantity  Int
  reason             String                    @db.Text
  status             PurchaseRequisitionStatus @default(DRAFT)
  createdById        String?
  createdBy          User?                     @relation("PrCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assetRequests      AssetRequest[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([categoryId])
  @@index([status])
  @@map("purchase_requisitions")
}

// ============================================================
// Asset Request, Approval, Custody & Clearance Workflow
// ============================================================

enum AssetRequestStatus {
  DRAFT
  SUBMITTED
  PENDING_PM_APPROVAL
  PENDING_HR_VERIFICATION
  PENDING_FINANCE_APPROVAL
  PENDING_FINAL_HR_APPROVAL
  PENDING_ASSET_ASSIGNMENT
  PENDING_PROCUREMENT
  ASSET_ISSUED
  REJECTED
  CLOSED
  CANCELLED
}

enum AssetRequestUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetRequestApprovalStep {
  PROJECT_MANAGER
  HR_VERIFICATION
  FINANCE
  HR_FINAL
  ASSET_MANAGER
  ASSET_DIRECTOR
}

enum AssetRequestApprovalDecision {
  APPROVED
  REJECTED
  CLARIFICATION
  RETURNED
}

enum AssetReturnOutcome {
  RETURNED_GOOD
  RETURNED_DAMAGED
  LOST
  STOLEN
  REPAIR_REQUIRED
}

enum AssetDamageCaseStatus {
  OPEN
  UNDER_REVIEW
  REPAIR
  RECOVER_COST
  WRITTEN_OFF
  INSURANCE
  CLOSED
}

enum AssetLossCaseStatus {
  OPEN
  UNDER_REVIEW
  RECOVERED
  PARTIAL_RECOVERY
  INSURANCE
  WRITTEN_OFF
  CLOSED
}

enum AssetClearanceItemStatus {
  PENDING
  RETURNED
  DAMAGED
  LOST
  WAIVED
}

model AssetRequestSequence {
  year       Int @id
  lastNumber Int @default(0)

  @@map("asset_request_sequences")
}

model AssetRequest {
  id                      String              @id @default(uuid())
  requestNumber           String              @unique
  employeeId              String
  employee                User                @relation("AssetRequestEmployee", fields: [employeeId], references: [id])
  department              String?
  subDepartment           String?
  projectId               String?
  project                 Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  designation             String?
  requestDate             DateTime            @default(now())
  categoryId              String
  category                AssetCategory       @relation(fields: [categoryId], references: [id])
  assetType               String?
  assetDescription        String?             @db.Text
  brandPreference         String?
  modelPreference         String?
  quantity                Int                 @default(1)
  businessJustification   String              @db.Text
  urgency                 AssetRequestUrgency @default(MEDIUM)
  requiredByDate          DateTime?           @db.Date
  expectedUsageDuration   String?
  additionalNotes         String?             @db.Text
  attachmentPath          String?
  status                  AssetRequestStatus  @default(DRAFT)
  assignedProjectManagerId String?
  assignedProjectManager  User?               @relation("AssetRequestPm", fields: [assignedProjectManagerId], references: [id], onDelete: SetNull)
  purchaseRequisitionId   String?
  purchaseRequisition     PurchaseRequisition? @relation(fields: [purchaseRequisitionId], references: [id], onDelete: SetNull)
  custodyDocumentPath     String?
  submittedAt             DateTime?
  closedAt                DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  approvals    AssetRequestApproval[]
  assignments  AssetRequestAssignment[]
  returns      AssetReturn[]
  auditLogs    AssetRequestAuditLog[]
  damageCases  AssetDamageCase[]
  lossCases    AssetLossCase[]

  @@index([employeeId])
  @@index([status])
  @@index([assignedProjectManagerId])
  @@index([projectId])
  @@map("asset_requests")
}

model AssetRequestApproval {
  id          String                       @id @default(uuid())
  requestId   String
  request     AssetRequest                 @relation(fields: [requestId], references: [id], onDelete: Cascade)
  step        AssetRequestApprovalStep
  decision    AssetRequestApprovalDecision
  comments    String?                      @db.Text
  approvalNotes String?                    @db.Text
  approverId  String?
  approver    User?                        @relation("AssetRequestApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decidedAt   DateTime                     @default(now())
  metadata    Json?

  @@index([requestId])
  @@index([step])
  @@map("asset_request_approvals")
}

model AssetRequestAssignment {
  id              String       @id @default(uuid())
  requestId       String
  request         AssetRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assetId         String
  asset           Asset        @relation(fields: [assetId], references: [id])
  employeeId      String
  employee        User         @relation("AssetAssignmentEmployee", fields: [employeeId], references: [id])
  issueDate       DateTime     @default(now())
  conditionNotes  String?
  warrantyInfo    String?
  locationType    AssetLocationType?
  locationId      String?
  department      String?
  projectId       String?
  assignedById    String?
  custodyDocPath  String?
  previousCustodianId String?
  transferReason  String?
  createdAt       DateTime     @default(now())

  @@index([requestId])
  @@index([assetId])
  @@index([employeeId])
  @@map("asset_request_assignments")
}

model AssetReturn {
  id                  String             @id @default(uuid())
  requestId           String?
  request             AssetRequest?      @relation(fields: [requestId], references: [id], onDelete: SetNull)
  assetId             String
  asset               Asset              @relation(fields: [assetId], references: [id])
  custodianId         String
  custodian           User               @relation("AssetReturnCustodian", fields: [custodianId], references: [id])
  processedById       String?
  processedBy         User?              @relation("AssetReturnProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  returnDate          DateTime           @default(now())
  outcome           AssetReturnOutcome
  conditionNotes    String?            @db.Text
  accessoriesReturned String?          @db.Text
  damageDetails     String?            @db.Text
  missingComponents String?            @db.Text
  photoPaths        Json?
  remarks           String?            @db.Text
  createdAt         DateTime           @default(now())

  damageCase AssetDamageCase?
  lossCase   AssetLossCase?

  @@index([assetId])
  @@index([custodianId])
  @@map("asset_returns")
}

model AssetDamageCase {
  id           String                @id @default(uuid())
  returnId     String                @unique
  assetReturn  AssetReturn           @relation(fields: [returnId], references: [id], onDelete: Cascade)
  requestId    String?
  request      AssetRequest?         @relation(fields: [requestId], references: [id], onDelete: SetNull)
  assetId      String
  asset        Asset                 @relation(fields: [assetId], references: [id])
  status       AssetDamageCaseStatus @default(OPEN)
  description  String                @db.Text
  estimatedCost Decimal?             @db.Decimal(12, 2)
  resolution   String?               @db.Text
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([assetId])
  @@map("asset_damage_cases")
}

model AssetLossCase {
  id              String            @id @default(uuid())
  returnId        String            @unique
  assetReturn     AssetReturn       @relation(fields: [returnId], references: [id], onDelete: Cascade)
  requestId       String?
  request         AssetRequest?     @relation(fields: [requestId], references: [id], onDelete: SetNull)
  assetId         String
  asset           Asset             @relation(fields: [assetId], references: [id])
  status          AssetLossCaseStatus @default(OPEN)
  employeeExplanation String?       @db.Text
  recoveryAmount  Decimal?          @db.Decimal(12, 2)
  resolution      String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([assetId])
  @@map("asset_loss_cases")
}

model AssetClearanceRecord {
  id           String                   @id @default(uuid())
  userId       String
  user         User                     @relation("AssetClearanceEmployee", fields: [userId], references: [id], onDelete: Cascade)
  resignationId String?
  assetId      String?
  asset        Asset?                   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assetLabel   String
  status       AssetClearanceItemStatus @default(PENDING)
  notes        String?                  @db.Text
  resolvedAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([userId])
  @@index([resignationId])
  @@map("asset_clearance_records")
}

model AssetRequestAuditLog {
  id          String       @id @default(uuid())
  requestId   String
  request     AssetRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?        @relation("AssetRequestAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  previousStatus AssetRequestStatus?
  newStatus   AssetRequestStatus?
  comment     String?      @db.Text
  metadata    Json?
  createdAt   DateTime     @default(now())

  @@index([requestId, createdAt])
  @@map("asset_request_audit_logs")
}
